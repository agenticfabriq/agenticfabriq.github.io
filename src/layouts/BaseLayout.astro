---
import Seo from '../components/Seo.astro';
import { PILLARS } from '../lib/pillars';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  ogType?: string;
}

const { title, description, path, jsonLd, ogType } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="application/rss+xml" title="Agent Integration Playbook" href="/rss.xml" />
    <Seo title={title} description={description} path={path} jsonLd={jsonLd} ogType={ogType} />
  </head>
  <body>
    <header class="site">
      <a href="/"><strong>Agent Integration Playbook</strong></a>
      <nav>
        {PILLARS.map((pillar) => <a href={`/${pillar.slug}/`}>{pillar.title}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <p>
        <a href="/about/">About this library</a> — who publishes it, how it is fact-checked,
        and how to report an error.
      </p>
      <p>
        Maintained by <a href="https://www.agenticfabriq.com/">Agentic Fabriq</a>, makers of <a href="https://www.agenticfabriq.com/developers">Fabriq Developer</a>, an MCP gateway that brokers per-user OAuth for agents.
        Prose licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
        code <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache-2.0</a>.
        <a href="https://github.com/agenticfabriq/agenticfabriq.github.io">Improve this page on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
